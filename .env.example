# ---------------------------------------------------------------------------
# DevPulse configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# GitHub Personal Access Token (read-only). Kept in memory only: it is never
# written to PostgreSQL, logs, HTML or API responses.
GITHUB_TOKEN=

# The ONE organization this deployment analyzes. Organizations the token can
# also reach are never queried or imported.
GITHUB_ORG=my-company

# PostgreSQL connection string. The hostname "postgres" is the compose service.
DATABASE_URL=postgres://devpulse:devpulse@postgres:5432/devpulse?sslmode=disable

# How often the sync worker runs. Minimum 1m.
SYNC_INTERVAL=30m

# How far back the first synchronization reaches, in months (1-120).
HISTORY_MONTHS=12

# Archived repositories are always stored. When false they are excluded from
# rankings, totals and charts, and their activity is not collected.
INCLUDE_ARCHIVED=false

# Logins excluded from contributor rankings, comma separated. Accounts GitHub
# itself reports as bots are excluded automatically.
EXCLUDED_USERS=dependabot[bot],renovate[bot]

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Host port the dashboard is published on.
# APP_PORT=8080

# debug | info | warn | error
# LOG_LEVEL=info

# Synchronize once immediately at startup.
# SYNC_ON_STARTUP=true

# Stop synchronizing when fewer than this many GraphQL points remain.
# MIN_RATE_LIMIT_REMAINING=200

# Cap the number of repositories imported (0 = no limit). Useful for a trial run
# against a very large organization.
# MAX_REPOSITORIES=0

# GitHub Enterprise Server GraphQL endpoint.
# GITHUB_API_URL=https://api.github.com/graphql

# Credentials for the bundled PostgreSQL service.
# POSTGRES_USER=devpulse
# POSTGRES_PASSWORD=devpulse
# POSTGRES_DB=devpulse
